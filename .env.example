# Neon: copy the POOLED connection string from the Neon dashboard (Connection details).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional public URL of the site. Use http://localhost:3000 locally.
# On Vercel, leave blank to use the project's production domain automatically.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Anastasiia Fedorova"

# Optional email (Resend). Without a key, emails are only printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Grande Ballroom Studio <onboarding@resend.dev>"
CONTACT_EMAIL="studio@example.com"

# Protects the daily reminder cron route (Vercel sends it automatically). Any random string.
CRON_SECRET=""
